# Required — single key for all AI calls (LLM + TTS) via OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides
LLM_MODEL=openai/gpt-4o-mini
TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
TTS_VOICE=alloy

# Default narration language selected in the CLI prompt (e.g. English, Turkish)
TTS_LANG=English

# Maximum agent execution turns before the explore stage aborts (default: 15)
EXPLORE_MAX_TURNS=15

# Maximum parallel text-to-speech synthesis calls (default: 4)
TTS_CONCURRENCY=4
